/* core/runtime on st: generated by `patchkit gen` from the device files and the module manifests; do not edit. */
    .equ DEVICE_ID, 0x3    /* [digikit] id */
    .equ DEVICE_NAME_WORD, 0x73740000    /* [digikit] name, NUL padded, as a big-endian word */
    .equ SAMPLES_IN_STORE, 0x1    /* [capabilities] card = "slots": the samples are files of the digikit store */
    .equ SAMPLE_PATH_MAX, 0x97    /* [digikit] sample_path_max */
    .equ STORE_FIRST, 0x200000    /* [card.store] first_sector (0: no store) */
    .equ STORE_SECTORS, 0x100000    /* [card.store] end_sector - first_sector (0: no store) */
    .equ DSP_HEADROOM, 0x0    /* DSP instructions per block left for modules: the block at 85 percent (projected with the high cycle factor) less the stock firmware's load (devices/cycle-factors.json, dkprof::budget) */
    .equ DSP_VOICES, 0x0    /* [adapter.machine] voices: the voices a machine's per-voice DSP cost counts for */
    .equ PEEK_N, 0x2    /* [digikit] peek: number of ranges */
    .equ SPAN_CLOCK, 0xfc07800c    /* [digikit] span_clock (address of the profiling clock; 0 none) */
    .equ SPAN_CLOCK_HZ, 0x7de2900    /* [digikit] span_clock_hz (its frequency) */
    .equ FX_KIT_PTR, 0x0    /* [fx] kit_ptr (the firmware's pointer to the live kit object) */
    .equ FX_TAIL_OFF, 0x0    /* [fx] tail_off (the u32 after the array's halfwords: the loader and saver copy it, bytes from the array) */
    .equ FX_SOUND_OFF, 0x0    /* [fx] sound_off (the first Sound object in the kit object, bytes from the kit object) */
    .equ FX_SOUND_STRIDE, 0x0    /* [fx] sound_stride (bytes between the 16 Sound objects) */
    .equ FX_SOUND_WORDS, 0x0    /* [fx] sound_words (s16 parameter words in a Sound object's array) */
    .equ PEEK_LO_0, 0x40000000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_0, 0x45570000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_1, 0x478c0000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_1, 0x47bf1000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_2, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_2, 0x0    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_3, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_3, 0x0    /* [digikit] peek range end (exclusive) */
