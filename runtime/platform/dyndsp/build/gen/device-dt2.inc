/* core/dyndsp on dt2: generated by `patchkit gen` from the device files and the module manifests; do not edit. */
    .equ DEVICE_ID, 0x1    /* [digikit] id */
    .equ DYN_TYPES, 0x8    /* run-time machine types; core/rows reserves one machine row and core/dyndsp one voice row for each */
    .equ DL_AREA_BYTES, 0x80000    /* [digikit] dsp_area_bytes */
    .equ DL_SLOT_BYTES, 0x40    /* [dsp.slots] words * 4 of sdk/sdk.toml: the slot block at the start of window 0 (DK_SLOT_BYTES of dk_stub.inc) */
