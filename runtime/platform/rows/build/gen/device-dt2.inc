/* core/rows on dt2: generated by `patchkit gen` from the device files and core/machines types.toml; do not edit. */
    .equ DEVICE_ID, 0x1    /* [digikit] id */
    .equ LIMIT_MACHINE_ROWS, 0x8    /* [limits] machine_rows (run-time machine and voice rows) */
    .equ LIMIT_FX_SLOTS, 0x3    /* [limits] fx_slots (effects in the chain: CAPACITY's limit and the free effect rows of core/dynfx) */
    .equ LIMIT_PARAM_ROWS, 0x10    /* [limits] param_rows (parameter rows the run-time machines fill: the first block of core/rows) */
    .equ LIMIT_PAGE_ROWS, 0x0    /* [limits] page_rows (machine page rows; 0 on a device that keeps the knobs in the machine row) */
    .equ LIMIT_SEND_ROWS, 0x2    /* [limits] send_rows (parameter rows reserved for the cells of the send page) */
    .equ LIMIT_SEND_SLOTS, 0x2    /* [limits] send_slots (effects on a send bus: the cells of the send page; 0 on a device without one) */
