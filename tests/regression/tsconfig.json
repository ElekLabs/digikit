{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@digi/dk-session/*": ["../../packages/dk-session/src/*.ts"],
      "@digi/test-support": ["../../packages/test-support/src/index.ts"],
      "@digi/control-client": ["../../packages/control-client/src/index.ts"]
    }
  },
  "include": ["*.ts", "dt2", "runtime", "modules", "host", "scenarios", "../../modules/*/*/tests/*.test.ts"]
}
