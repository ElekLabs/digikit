{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/desktop",
  "implicitDependencies": ["@digi/web", "@digi/dk-session"],
  "targets": {
    "test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "hostTests",
        "^hostTests",
        "{workspaceRoot}/devices/**/*.toml",
        "{workspaceRoot}/modules/*/*/module.toml"
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project desktop-host",
        "cwd": "."
      }
    }
  }
}
