{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/desktop",
  "implicitDependencies": ["@digi/workbench-core", "@digi/dk-session", "digiemu-desktop", "dkui-host", "dkprof"],
  "targets": {
    "build:ui": {
      "cache": true,
      "inputs": [
        "default",
        {
          "input": "production",
          "projects": ["@digi/workbench-core", "@digi/dk-session", "@digi/dkbs", "control-client"]
        },
        "jsToolchain",
        {
          "externalDependencies": [
            "vite-plugin-solid",
            "pixi.js",
            "fft.js",
            "@tauri-apps/api",
            "@fontsource-variable/archivo",
            "@fontsource/jetbrains-mono"
          ]
        },
        "{workspaceRoot}/modules/*/*/*/module.toml",
        "{workspaceRoot}/modules/*/*/*/workbench.toml",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/devices/calibration/**/*",
        "{workspaceRoot}/modules/*/*/*/calibration.toml"
      ],
      "outputs": ["{projectRoot}/ui/dist"]
    },
    "workbench-inputs": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:ui",
        {
          "projects": ["core/runtime"],
          "target": "package"
        },
        {
          "projects": ["@digi/web"],
          "target": "patchkit-wasm"
        },
        {
          "projects": ["patchkit"],
          "target": "ports"
        },
        {
          "projects": [
            "core/services/machines",
            "core/services/fx",
            "core/services/lfo",
            "core/services/samples",
            "core/services/project",
            "core/services/shortcuts"
          ],
          "target": "pack"
        }
      ]
    },
    "check:ui": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tests/fixtures/modules/settings-a/module.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench/*",
        "default",
        {
          "input": "production",
          "projects": ["@digi/workbench-core", "@digi/dk-session", "@digi/dkbs", "control-client"]
        },
        "jsToolchain",
        {
          "externalDependencies": [
            "vite-plugin-solid",
            "pixi.js",
            "fft.js",
            "@tauri-apps/api",
            "@fontsource-variable/archivo",
            "@fontsource/jetbrains-mono"
          ]
        },
        "{workspaceRoot}/modules/*/*/*/module.toml",
        "{workspaceRoot}/modules/*/*/*/workbench.toml",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/devices/calibration/**/*",
        "{workspaceRoot}/modules/*/*/*/calibration.toml"
      ],
      "outputs": []
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "description": "Host tests; the Log names tests load the real dkprof.wasm (dkprof:wasm, built on demand, keyed on the Rust crates below).",
      "dependsOn": [{ "projects": ["dkprof"], "target": "wasm" }],
      "inputs": [
        "{workspaceRoot}/tests/fixtures/modules/settings-a/module.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench/*",
        "{projectRoot}/ui/**/*",
        "!{projectRoot}/ui/dist/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/ui/tsconfig.json",
        "jsToolchain",
        {
          "externalDependencies": [
            "vite-plugin-solid",
            "pixi.js",
            "fft.js",
            "@tauri-apps/api",
            "@fontsource-variable/archivo",
            "@fontsource/jetbrains-mono"
          ]
        },
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host/desktop-host.json",
        "{workspaceRoot}/tsconfig*.json",
        {
          "externalDependencies": ["vitest"]
        },
        "{workspaceRoot}/packages/workbench-core/src/**/*",
        "{workspaceRoot}/packages/workbench-core/ui/**/*",
        "{workspaceRoot}/packages/workbench-core/package.json",
        "{workspaceRoot}/packages/dk-session/src/**/*",
        "{workspaceRoot}/packages/dk-session/package.json",
        "{workspaceRoot}/packages/dkbs/src/**/*",
        "{workspaceRoot}/packages/dkbs/package.json",
        "{workspaceRoot}/packages/dkprof/src/**/*",
        "{workspaceRoot}/packages/dkprof/Cargo.toml",
        "{workspaceRoot}/packages/dkaddrmap/src/**/*",
        "{workspaceRoot}/packages/dkaddrmap/Cargo.toml",
        "{workspaceRoot}/packages/dksharc/src/**/*",
        "{workspaceRoot}/packages/dksharc/Cargo.toml",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/devices/calibration/**/*",
        "{workspaceRoot}/modules/*/*/*/calibration.toml",
        "{workspaceRoot}/modules/*/*/*/module.toml",
        "{workspaceRoot}/modules/*/*/*/workbench.toml",
        "{workspaceRoot}/config/emulator.json"
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project desktop-host",
        "cwd": "."
      }
    },
    "typecheck": {
      "inputs": [
        "{workspaceRoot}/tests/fixtures/modules/settings-a/module.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench.toml",
        "{workspaceRoot}/tests/fixtures/modules/settings-a/workbench/*",
        "default",
        {
          "input": "production",
          "projects": ["@digi/workbench-core", "@digi/dk-session", "@digi/dkbs", "control-client"]
        },
        "jsToolchain",
        {
          "externalDependencies": [
            "vite-plugin-solid",
            "pixi.js",
            "fft.js",
            "@tauri-apps/api",
            "@fontsource-variable/archivo",
            "@fontsource/jetbrains-mono"
          ]
        }
      ]
    }
  }
}
