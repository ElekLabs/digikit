{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/desktop",
  "implicitDependencies": ["@digi/web", "@digi/dk-session", "digiemu-desktop", "dkui-host", "dkprof"],
  "targets": {
    "build:ui": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/modules/*/*/module.toml",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/devices/*.toml"
      ],
      "outputs": ["{projectRoot}/ui/dist"]
    },
    "workbench-inputs": {
      "executor": "nx:noop",
      "dependsOn": [
        "build:ui",
        {
          "projects": ["@digi/web"],
          "target": "patchkit-wasm"
        }
      ]
    },
    "check:ui": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/modules/*/*/module.toml",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/apps/web/tests/fakeflash.mjs",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/apps/web/tests/fakeflash.d.mts"
      ],
      "outputs": []
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "description": "Host tests; the Log names tests load the real dkprof.wasm (dkprof:wasm, built on demand, keyed on the Rust crates below).",
      "dependsOn": [{ "projects": ["dkprof"], "target": "wasm" }],
      "inputs": [
        "{projectRoot}/ui/**/*",
        "!{projectRoot}/ui/dist/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/ui/tsconfig.json",
        "jsToolchain",
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host.projects.json",
        "{workspaceRoot}/tsconfig*.json",
        {
          "externalDependencies": ["vitest"]
        },
        "{workspaceRoot}/apps/web/src/**/*",
        "{workspaceRoot}/apps/web/site.config.mjs",
        "{workspaceRoot}/packages/dk-session/src/**/*",
        "{workspaceRoot}/packages/dk-session/package.json",
        "{workspaceRoot}/packages/dkbs/src/**/*",
        "{workspaceRoot}/packages/dkbs/package.json",
        "{workspaceRoot}/packages/dkprof/src/**/*",
        "{workspaceRoot}/packages/dkprof/Cargo.toml",
        "{workspaceRoot}/packages/dkaddrmap/src/**/*",
        "{workspaceRoot}/packages/dkaddrmap/Cargo.toml",
        "{workspaceRoot}/packages/dksharc/src/**/*",
        "{workspaceRoot}/packages/dksharc/Cargo.toml",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/modules/*/*/module.toml",
        "{workspaceRoot}/config/emulator.json"
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project desktop-host",
        "cwd": "."
      }
    }
  }
}
