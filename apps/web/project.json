{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "@digi/web",
  "implicitDependencies": [
    "control-client",
    "@digi/dk-session",
    "patchkit",
    "dkupload",
    "dksample",
    "devices",
    "dkui-host"
  ],
  "targets": {
    "patchkit-wasm": {
      "executor": "nx:noop",
      "description": "Name of the wasm build for the web tests and the desktop workbench; the build is patchkit:wasm, keyed on the Rust crates only.",
      "dependsOn": [
        {
          "projects": ["patchkit"],
          "target": "wasm"
        }
      ],
      "inputs": []
    },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/tools/emulator/ready_inputs.json",
        "{workspaceRoot}/modules/**/module.toml",
        "{workspaceRoot}/modules/**/gallery/icon.svg"
      ],
      "outputs": ["{projectRoot}/.astro"],
      "description": "astro check; it writes .astro/*.d.ts before it checks (the audit lists them as generated)."
    },
    "test-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*",
        "!{projectRoot}/tests/*.wasm.test.ts",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/public/pcm-worklet.js",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/site.config.mjs",
        "jsToolchain",
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host.projects.json",
        "{workspaceRoot}/tsconfig*.json",
        {
          "externalDependencies": ["vitest"]
        },
        "{workspaceRoot}/packages/dk-session/src/**/*",
        "{workspaceRoot}/packages/dk-session/package.json",
        "{workspaceRoot}/packages/dkbs/src/**/*",
        "{workspaceRoot}/packages/dkbs/package.json",
        "{workspaceRoot}/devices/*.toml",
        "{workspaceRoot}/devices/ports/*",
        "{workspaceRoot}/modules/**/module.toml",
        "{workspaceRoot}/modules/**/gallery/icon.svg",
        "{workspaceRoot}/tests/fixtures/modules/**/module.toml",
        "{workspaceRoot}/config/emulator.json"
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project web-transfer",
        "cwd": ".",
        "env": {
          "DIGI_FW_EMU_SOCKET": ""
        }
      }
    },
    "test-wasm": {
      "description": "Tests that load the real public/*.wasm or run the patchkit command line: the Vitest project web-wasm (tests/*.wasm.test.ts).",
      "dependsOn": ["patchkit-wasm"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/public/*.js",
        "{projectRoot}/tests/*.wasm.test.ts",
        "{projectRoot}/tests/fit-wasm.ts",
        "{projectRoot}/tests/support/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/site.config.mjs",
        "^production",
        "jsToolchain",
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host.projects.json"
      ]
    }
  }
}
