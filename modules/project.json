{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "module-tests",
  "targets": {
    "test-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": ["hostTests"],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project module-tests --passWithNoTests",
        "cwd": "."
      }
    }
  }
}
