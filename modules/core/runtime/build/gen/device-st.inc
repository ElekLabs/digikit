/* core/runtime on st: generated by `patchkit gen` from the device files and core/machines types.toml; do not edit. */
    .equ DEVICE_ID, 0x3    /* [digikit] id */
    .equ DEVICE_NAME_WORD, 0x73740000    /* [digikit] name, NUL padded, as a big-endian word */
    .equ STORE_FIRST, 0x0    /* [card.store] first_sector (0: no store) */
    .equ STORE_SECTORS, 0x0    /* [card.store] end_sector - first_sector (0: no store) */
    .equ PEEK_N, 0x2    /* [digikit] peek: number of ranges */
    .equ FX_SOUND_WORDS, 0x0    /* [fx] sound_words (s16 parameter words in a Sound object's array) */
    .equ PEEK_LO_0, 0x40000000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_0, 0x45570000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_1, 0x478c0000    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_1, 0x47bf1000    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_2, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_2, 0x0    /* [digikit] peek range end (exclusive) */
    .equ PEEK_LO_3, 0x0    /* [digikit] peek range start (RAM the PEEK command may read) */
    .equ PEEK_HI_3, 0x0    /* [digikit] peek range end (exclusive) */
