/* core/ui on dn2: generated by `patchkit gen` from the device files and core/machines types.toml; do not edit. */
    .equ UI_KEY_YES, 0xa    /* [input.keys] YES (the key id of YES in a key event) */
    .equ UI_KEY_YES2, 0x31    /* [input.keys] LEVEL_PUSH (a second YES key) */
    .equ UI_KEY_NO, 0xc    /* [input.keys] NO (the key id of NO) */
    .equ UI_KEY_RIGHT, 0xf    /* [input.keys] RIGHT (the key id of RIGHT) */
    .equ KEY_FLAG_PRESS, 0x0    /* [input.key_flags] press (set on a press, clear on a release) */
    .equ KEY_FLAG_RELEASE, 0x4    /* [input.key_flags] release (set on a release) */
