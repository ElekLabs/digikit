/* core/dynreg on dn2: generated by `patchkit gen` from the device files and core/machines types.toml; do not edit. */
    .equ DEVICE_ID, 0x2    /* [digikit] id */
    .equ DYN_TYPES, 0x8    /* run-time machine types; core/dynreg reserves one machine row and core/dyndsp one voice row for each */
    .equ PROFILE_CLONE_OF, 0x0    /* [modules.knobs] clone_of */
    .equ PROFILE_LEVEL, 0xa    /* [modules.knobs] level_default */
    .equ PROFILE_OWN_DSP, 0x1    /* [modules.knobs] own_dsp (0 or 1) */
    .equ PROFILE_TUNE_CODE, 0x0    /* [modules.knobs] tune on a machine-row device (0: none) */
    .equ PROFILE_TUNE_SLOT, 0x0    /* [adapter.machine] tune_slot */
    .equ PROFILE_LEVEL_CODE, 0x0    /* [modules.knobs] level on a machine-row device (0: none) */
    .equ PROFILE_LEVEL_KNOB, 0x0    /* [modules.knobs] level_knob */
    .equ PROFILE_SLOT_COUNT, 0x8    /* [adapter.machine] param_slots, the count */
    .equ PROFILE_SLOT_0, 0x1    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_1, 0x2    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_2, 0x4    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_3, 0x5    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_4, 0x6    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_5, 0x0    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_6, 0x3    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_SLOT_7, 0x7    /* [adapter.machine] param_slots (knob position of the machine's word i) */
    .equ PROFILE_TPL_ENCODER, 0xd5    /* [modules.templates] (stock parameter row of a glyph) */
    .equ PROFILE_TPL_FADER, 0xd7    /* [modules.templates] (stock parameter row of a glyph) */
    .equ PROFILE_TPL_PAN, 0x47    /* [modules.templates] (stock parameter row of a glyph) */
    .equ PROFILE_TPL_ONOFF, 0xdd    /* [modules.templates] (stock parameter row of a glyph) */
    .equ PROFILE_TPL_TUNE, 0xee    /* [modules.templates] (stock parameter row of a glyph) */
    .equ PROFILE_TPL_PLAY, 0xd5    /* [modules.templates] (stock parameter row of a glyph) */
