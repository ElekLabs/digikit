{
  "_doc": "Runtime source areas of the merge gate (tools/nx/runtime-areas.mjs, docs/TESTING.md 'Runtime areas'). Every file under 'scope' (minus 'exclude') is classified here: in one or more areas (firmware-facing: their device tests run) or in 'hostProven' (host-only files: vectors, fakes, test support, docs; proven by unit and assembly tests, no device test beyond the smoke set). A file in neither fails the check (`node tools/nx/runtime-areas.mjs --check`, the runtime-areas host test and the gate): there is no full-suite fallback; the full suite runs at milestone merges. 'tests' entries are 'project:file' or 'project:*'; '@all' is every test of every other area (area 'image'). Full-tier tests (no gate leaf target) are not mapped; the full suite runs them. A file that matches several areas selects all of them (union). An area match wins over 'hostProven' (so host-only files must not match an area glob). Unit-test sources ('testSources') are host-proven before the areas are read. 'exclude' keeps owner-based selection (device test projects, build output).",
  "scope": [
    "runtime/core/**",
    "runtime/platform/**"
  ],
  "exclude": [
    "runtime/core/tests/**",
    "runtime/core/target/**"
  ],
  "testSources": [
    "**/tests.rs",
    "**/tests/**",
    "**/*_tests.rs"
  ],
  "hostProven": [
    "**/*.md",
    "**/project.json",
    "runtime/core/owners.toml",
    "runtime/core/{test-support,vectors}/**",
    "runtime/core/src/rs/src/{fake_boot_env,fake_platform,fake_storage,host_io,test_lock,gen_abi_check}.rs",
    "runtime/core/src/rs/src/fake_platform/**",
    "runtime/core/abi/src/{fw,fw_id,keys,plan,regcheck,sha256,version}.rs",
    "runtime/core/sdk/src/{command,result_text,sel,sticky}.rs",
    "runtime/platform/ui/host/**"
  ],
  "areas": {
    "live-reload": {
      "globs": [
        "runtime/core/src/rs/src/package/loader/{install,park,live,unload,quiesce,op_clock,provider_reload}.rs",
        "runtime/core/src/rs/src/package/loader/install/**",
        "runtime/core/src/rs/src/package/lifecycle/**",
        "runtime/core/src/rs/src/package/reload/**",
        "runtime/core/lifecycle/src/live.rs",
        "runtime/core/lifecycle/src/manager/reload.rs",
        "runtime/core/build/package.dko.json"
      ],
      "tests": [
        "core/runtime-tests:*",
        "core/runtime-provider-tests:service-reload.device.test.ts",
        "core/runtime-provider-tests:owner-step.device.test.ts",
        "core/runtime-lfo-tests:lfo-shape-output.device.test.ts",
        "core/services/project-tests:project-reload.device.test.ts"
      ]
    },
    "module-load": {
      "globs": [
        "runtime/core/src/rs/src/package/loader/**",
        "runtime/core/src/rs/src/package/{admission,capacity,collect,files,image,imports,invariants,link,registry,scan,fake_checked_images}.rs",
        "runtime/core/src/rs/src/package/collect/**",
        "runtime/core/link/**",
        "runtime/core/fit/**",
        "runtime/core/abi/src/{module,image,link,package,registry}.rs",
        "runtime/core/sdk/src/capacity.rs",
        "runtime/core/build/package.dko.json"
      ],
      "tests": [
        "core/runtime-capacity-tests:*",
        "core/runtime-fixture-tests:*",
        "core/runtime-refusal-tests:*",
        "core/runtime-entry-tests:*"
      ]
    },
    "dsp": {
      "globs": [
        "runtime/core/src/rs/src/package/dsp/**",
        "runtime/core/src/rs/src/package/dsp_stats.rs",
        "runtime/core/abi/src/dsp.rs",
        "runtime/core/abi/src/provider/tables/dsp.rs",
        "runtime/core/build/package.dko.json"
      ],
      "tests": [
        "core/runtime-fixture-tests:*",
        "core/runtime-machines-tests:*",
        "core/services/fx-tests:fx-routing.device.test.ts",
        "core/services/fx-tests:fx-send.device.test.ts",
        "core/runtime-tests:reload-fx.device.test.ts",
        "core/runtime-lfo-tests:*"
      ]
    },
    "services": {
      "globs": [
        "runtime/core/src/rs/src/package/{handlers,provider_rows,fixture_provider,core_api,entry,commands,live_cmds,module_cmds,hooks,svc_imports,gen_services,settings_overlay,settings_reload,host_dir}.rs",
        "runtime/core/src/rs/src/package/{handlers,provider_rows,host_dir}/**",
        "runtime/core/src/rs/src/{hooks,host_dir}.rs",
        "runtime/core/src/rs/src/{hooks,host_dir}/**",
        "runtime/core/svc-rt/**",
        "runtime/core/abi/src/provider.rs",
        "runtime/core/abi/src/provider/**",
        "runtime/core/abi/src/{service,service_table,core_api,core_imports,command,gen_svc_abi,shared,host_dir}.rs",
        "runtime/core/abi/src/host_dir/**",
        "runtime/core/abi/src/service_table/**",
        "runtime/core/abi/src/resident/host_dir.rs",
        "runtime/core/build/package.dko.json"
      ],
      "tests": [
        "core/runtime-provider-tests:*",
        "core/runtime-service-tests:*",
        "core/runtime-entry-tests:*",
        "core/runtime-lfo-tests:*",
        "core/services/project-tests:project.device.test.ts",
        "core/services/fx-tests:*",
