{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gate-smoke",
  "description": "Patchkit smoke matrix (tests/patchkit/smoke/matrix.toml). Inputs: the Python harness closure, the daemon sources, the core modules and fixtures the matrix names.",
  "targets": {
    "smoke": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": true,
      "dependsOn": ["digi-control:daemons", "core/runtime:package", "plusdrive-format:cli"],
      "outputs": [],
      "inputs": [
        "{workspaceRoot}/tools/__init__.py",
        "{workspaceRoot}/tools/patchkit/pk_harness.py",
        "{workspaceRoot}/tools/patchkit/patchkit.py",
        "{workspaceRoot}/tools/patchkit/modroots.py",
        "{workspaceRoot}/tools/patchkit/pk_emud_pgo.py",
        "{workspaceRoot}/tools/patchkit/pk_dsp_budget.py",
        "{workspaceRoot}/tools/patchkit/pk_mem.py",
        "{workspaceRoot}/tools/patchkit/pk_device.py",
        "{workspaceRoot}/tools/control/digi_client.py",
        "{workspaceRoot}/tools/emulator/card_check.py",
        "{workspaceRoot}/tools/emulator/digi_env.py",
        "{workspaceRoot}/tools/emulator/native_target.py",
        "{workspaceRoot}/tools/emulator/native_pgo.py",
        "{workspaceRoot}/tools/emulator/native_emu.py",
        "{workspaceRoot}/config/emulator.json",
        "{workspaceRoot}/tools/firmware/config.py",
        "{workspaceRoot}/tools/firmware/device.py",
        "{workspaceRoot}/tools/device/dklog_kinds.py",
        "{workspaceRoot}/tools/devtools/portable_flock.py",
        "{workspaceRoot}/tools/devtools/stablebin.py",
        "{workspaceRoot}/tools/devtools/emud_key.py",
        "{workspaceRoot}/tools/devtools/verify_build.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_core/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile/**/*.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_transpile_infer.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_rsgen.py",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/packages/emulator/**/*",
        "!{workspaceRoot}/packages/emulator/README.md",
        "{workspaceRoot}/packages/dkneeds/**/*",
        "{workspaceRoot}/packages/dksample/**/*",
        "{workspaceRoot}/packages/dkupload/**/*",
        "{workspaceRoot}/packages/patchkit/**/*",
        "{workspaceRoot}/runtime/core/fit/Cargo.toml",
        "{workspaceRoot}/runtime/core/fit/src/**/*",
        "{workspaceRoot}/runtime/core/sdk/Cargo.toml",
        "{workspaceRoot}/runtime/core/sdk/src/**/*",
        "!{workspaceRoot}/{packages,modules,runtime,services,image-modules,ports/bindings}/**/{tests.rs,tests_*.rs,*_tests.rs,fake_*.rs}",
        "!{workspaceRoot}/{packages,modules,runtime,services,image-modules,ports/bindings}/**/tests/**/*.rs",
        "{workspaceRoot}/devices/**/*",
        "{workspaceRoot}/ports/*.toml",
        "{workspaceRoot}/ports/fw/**/*",
        "{workspaceRoot}/tests/scenarios/dn2.json",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/tools/patchkit/toolchain/**/*",
        "{workspaceRoot}/tools/nx/daemon-env.mjs",
        "{workspaceRoot}/dist/syspkg/runtime/system.dksp",
        "{workspaceRoot}/dist/plusdrive/plusdrive",
        "{workspaceRoot}/tests/patchkit/smoke/matrix.toml",
        "{workspaceRoot}/tests/patchkit/smoke/goldens.json",
        "{workspaceRoot}/tests/patchkit/smoke/tours/**/*",
        "{workspaceRoot}/{modules,runtime,services,image-modules}/**/module.toml",
        "{workspaceRoot}/tests/fixtures/{modules,runtime,services,image-modules}/**/module.toml",
        "{workspaceRoot}/sdk/include/**/*",
        "{workspaceRoot}/runtime/platform/rows/build/**/*",
        "{workspaceRoot}/runtime/platform/rows/src/**/*",
        "{workspaceRoot}/runtime/platform/rows/include/**/*",
        "{workspaceRoot}/runtime/platform/rows/tests/*.toml",
        "{workspaceRoot}/image-modules/points/dsp-voice/build/**/*",
        "{workspaceRoot}/image-modules/points/dsp-voice/src/**/*",
        "{workspaceRoot}/image-modules/points/dsp-voice/include/**/*",
        "{workspaceRoot}/image-modules/points/dsp-voice/tests/*.toml",
        "{workspaceRoot}/runtime/platform/dsp-link/build/**/*",
        "{workspaceRoot}/runtime/platform/dsp-link/src/**/*",
        "{workspaceRoot}/runtime/platform/dsp-link/include/**/*",
        "{workspaceRoot}/runtime/platform/dsp-link/tests/*.toml",
        "{workspaceRoot}/image-modules/points/fx/build/**/*",
        "{workspaceRoot}/image-modules/points/fx/src/**/*",
        "{workspaceRoot}/image-modules/points/fx/include/**/*",
        "{workspaceRoot}/image-modules/points/fx/tests/*.toml",
        "{workspaceRoot}/runtime/platform/ui/build/**/*",
        "{workspaceRoot}/runtime/platform/ui/src/**/*",
        "{workspaceRoot}/runtime/platform/ui/include/**/*",
        "{workspaceRoot}/runtime/platform/ui/tests/*.toml",
        "{workspaceRoot}/runtime/core/build/**/*",
        "{workspaceRoot}/runtime/core/src/**/*",
        "{workspaceRoot}/runtime/core/include/**/*",
        "{workspaceRoot}/runtime/core/tests/*.toml",
        "{workspaceRoot}/runtime/apps/digikit-menu/tests/*.toml",
        "{workspaceRoot}/runtime/platform/expansion/build/**/*",
        "{workspaceRoot}/runtime/platform/expansion/src/**/*",
        "{workspaceRoot}/runtime/platform/expansion/include/**/*",
        "{workspaceRoot}/runtime/platform/expansion/tests/*.toml",
        "{workspaceRoot}/tests/fixtures/modules/rust-demo/**/*",
        "{workspaceRoot}/tests/fixtures/modules/cf-demo/**/*",
        "{workspaceRoot}/tools/devtools/render_cache.py",
        "{workspaceRoot}/tools/emulator/coupled.py",
        "{workspaceRoot}/tools/emulator/dt2_sample_check.py",
        "{workspaceRoot}/tools/emulator/emulator_config.py",
        "{workspaceRoot}/tools/firmware/aplib.py",
        "{workspaceRoot}/tools/firmware/aplibpack.py",
        "{workspaceRoot}/tools/firmware/authcode.py",
        "{workspaceRoot}/tools/firmware/build.py",
        "{workspaceRoot}/tools/firmware/container.py",
        "{workspaceRoot}/tools/firmware/elz.py",
        "{workspaceRoot}/tools/firmware/extract.py",
        "{workspaceRoot}/tools/patchkit/dsp_patch.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_asm.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_disasm.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_isa.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_trace.py",
        "{workspaceRoot}/tools/sharc_dev/sharc_visa_tables.py",
        "{workspaceRoot}/tools/sharc_dev/sharcimm.py",
        "{workspaceRoot}/tools/sharc_dev/sharcldr.py",
        { "dependentTasksOutputFiles": "**/*", "transitive": true },
        { "runtime": "node tools/nx/device-inputs.mjs" },
        { "env": "DIGI_FX_SWEEP" },
        { "env": "DIGI_FX_NO_AOT_SUBSET" },
        { "env": "DIGI_EMU_FAST" },
        { "env": "DIGI_NO_PROGRESS_MS" },
        { "env": "DIGI_DT2_CARD" },
        { "env": "DIGI_COUPLED_FEATURES" },
        { "env": "SHARC_AOT" },
        { "env": "SHARC_FAST_REGIONS" },
        { "env": "SHARC_FAST_REGIONS_2" },
        { "env": "SHARC_BLOCKTRANS" },
        { "env": "SHARC_BLOCKTRANS_2" },
        { "env": "SHARC_FAST_FALLBACK_REGIONS" },
        { "env": "SHARC_FAST_FALLBACK_REGIONS_2" },
        { "env": "SHARC_FAST_AUTO" },
        { "env": "SHARC_GEN_DIR" },
        { "env": "DIGI_PK_PGO" },
        { "env": "UPDATE_GOLDENS" }
      ],
      "options": {
        "command": "node tools/devtools/emu-slot.mjs -- node tools/nx/daemon-env.mjs -- uv run python -m tools.patchkit.pk_harness run --jobs ${DIGI_JOBS:-4}",
        "cwd": "."
      }
    }
  }
}
