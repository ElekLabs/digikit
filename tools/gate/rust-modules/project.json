{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gate-rust-modules",
  "description": "Rust tests of patchkit and elektron-native-boot that build or scan the module library; runs when module sources, fixtures, devices or the SDK manifest change.",
  "targets": {
    "rust-tests": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{workspaceRoot}/{modules,runtime,services}/**/module.toml",
        "{workspaceRoot}/{modules,runtime,services,ports/bindings}/**/build/**/*",
        "{workspaceRoot}/{modules,runtime,services,ports/bindings}/**/src/**/*",
        "!{workspaceRoot}/{packages,modules,runtime,services,ports/bindings}/**/{tests.rs,tests_*.rs,*_tests.rs,fake_*.rs}",
        "!{workspaceRoot}/{packages,modules,runtime,services,ports/bindings}/**/tests/**/*.rs",
        "{workspaceRoot}/{modules,runtime,services,ports/bindings}/**/include/**/*",
        "{workspaceRoot}/tests/fixtures/{modules,runtime,services}/**/*",
        "{workspaceRoot}/devices/**/*",
        "{workspaceRoot}/ports/*.toml",
        "{workspaceRoot}/ports/fw/**/*",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/tools/patchkit/toolchain/**/*"
      ],
      "options": {
        "command": "node tools/nx/rust-env.mjs -- cargo nextest run -p patchkit --features record-rules -p elektron-native-boot --release --locked --offline",
        "cwd": "."
      }
    }
  }
}
