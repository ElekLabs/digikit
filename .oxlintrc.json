{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-solid"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-undef": "error",
    "solid/jsx-uses-vars": "error",
    "solid/no-destructure": "error",
    "solid/no-innerhtml": "error",
    "solid/no-react-deps": "error",
    "solid/no-react-specific-props": "error",
    "solid/prefer-for": "error",
    "solid/reactivity": "warn",
    "solid/self-closing-comp": "warn",
    "solid/components-return-once": "error",
    "solid/event-handlers": "warn",
    "solid/jsx-no-script-url": "error",
    "solid/no-array-handlers": "error",
    "solid/no-unknown-namespaces": "error",
    "solid/style-prop": "error",
    "solid/imports": "error"
  },
  "overrides": [
    {
      "files": ["apps/desktop/ui/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tauri-apps/api/core",
                "message": "Call the Tauri commands through the Host (packages/workbench-core/src/host/host.ts); only host/tauri-host.ts imports invoke."
              }
            ],
            "patterns": [
              {
                "group": ["**/apps/web/**", "**/web/src/**", "@digi/web"],
                "message": "The apps do not import each other: shared code lives in packages/workbench-core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**/*.{ts,tsx,mjs}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/apps/desktop/**", "**/desktop/ui/**", "@digi/desktop"],
                "message": "The apps do not import each other: shared code lives in packages/workbench-core."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/workbench-core/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/apps/**", "@digi/web", "@digi/desktop"],
                "message": "workbench-core is below the apps: it imports no app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/ui/src/host/tauri-host.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "apps/web/src/**/*.{ts,tsx}",
        "apps/desktop/ui/**/*.{ts,tsx}",
        "packages/workbench-core/{src,ui}/**/*.{ts,tsx}"
      ],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "Take a KeyValue (packages/workbench-core/src/storage.ts); only storage.ts reads localStorage."
          },
          {
            "name": "indexedDB",
            "message": "Take a BlobStore (packages/workbench-core/src/blob-store.ts); only blob-store.ts opens IndexedDB."
          },
          {
            "name": "Worker",
            "message": "Take a WorkerFactory (packages/workbench-core/src/workers.ts); only apps/web/src/browser-workers.ts calls new Worker."
          }
        ]
      }
    },
    {
      "files": [
        "packages/workbench-core/src/storage.ts",
        "packages/workbench-core/src/blob-store.ts",
        "apps/web/src/browser-workers.ts"
      ],
      "rules": {
        "eslint/no-restricted-globals": "off"
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "eslint/no-unassigned-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.astro",
    "**/target",
    "out",
    ".claude",
    "apps/web/.local",
    "apps/web/public",
    "apps/desktop/src-tauri/gen"
  ]
}
