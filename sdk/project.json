{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "sdk",
  "targets": {
    "test-host": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "{projectRoot}/project.json",
        "{projectRoot}/tests/**/*",
        "{projectRoot}/include/**/*",
        "{projectRoot}/src/core/**/*",
        "jsToolchain",
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host.projects.json",
        "{workspaceRoot}/tsconfig*.json",
        { "externalDependencies": ["vitest"] },
        "{workspaceRoot}/tools/nx/tests/sdk-contract.test.ts",
        "{workspaceRoot}/tests/fixtures/modules/sine/src/module.c",
        "{workspaceRoot}/tests/fixtures/modules/dyn-fx-gain-both/src/module.c"
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project nx-host tools/nx/tests/sdk-contract.test.ts",
        "cwd": "."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "jsToolchain",
        "{projectRoot}/tests/dsp/**/*",
        "{workspaceRoot}/tsconfig*.json",
        { "input": "production", "projects": ["@digi/sharc-rig-kit"] }
      ],
      "outputs": [],
      "options": {
        "command": "pnpm --filter @digi/sharc-rig-kit exec tsc -p ../../sdk/tests/dsp/tsconfig.json",
        "cwd": "."
      }
    },
    "test-dsp": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["patchkit:cli", "sharc-rig:build"],
      "inputs": [
        "jsToolchain",
        "{projectRoot}/**/*",
        "dspTestTooling",
        "{workspaceRoot}/packages/sharc-rig-kit/package.json",
        "{workspaceRoot}/vitest.host.config.ts",
        "{workspaceRoot}/vitest.host.projects.json",
        "{workspaceRoot}/tools/patchkit/toolchain/pins.toml",
        "{workspaceRoot}/tsconfig*.json",
        { "externalDependencies": ["vitest"] },
        { "dependentTasksOutputFiles": "**/*" }
      ],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "pnpm exec vitest run --config vitest.host.config.ts --project module-rig sdk/tests/dsp/",
        "cwd": "."
      }
    },
    "check-generated": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["patchkit:cli"],
      "outputs": [],
      "options": {
        "command": "dist/patchkit/patchkit --root . gen --check --scope shared",
        "cwd": "."
      },
      "inputs": [
        "jsToolchain",
        {
          "input": "production",
          "projects": ["patchkit"]
        },
        "{workspaceRoot}/sdk/project.json",
        "{workspaceRoot}/sdk/sdk.toml",
        "{workspaceRoot}/sdk/dsp/contract/dk_machine.inc",
        "{workspaceRoot}/sdk/dsp/contract/dk_fx.inc",
        "{workspaceRoot}/sdk/dsp/contract/dk_sample_pool.inc",
        "{workspaceRoot}/sdk/dsp/REGISTERS.md",
        "{workspaceRoot}/packages/dksharc/src/rules_table.rs",
        "{workspaceRoot}/sdk/include/dk/gen/**/*",
        "{workspaceRoot}/sdk/include/dk/core/status.h",
        "{workspaceRoot}/devices/**/*",
        "{workspaceRoot}/ports/*.toml",
        "{workspaceRoot}/ports/fw/**/*",
        "{workspaceRoot}/runtime/core/abi.toml",
        "{workspaceRoot}/runtime/core/include/dkrt.h",
        "{workspaceRoot}/runtime/core/sdk/src/gen_*.rs",
        "{workspaceRoot}/runtime/core/src/rs/src/gen_abi_check.rs",
        "{workspaceRoot}/services/*/dks/src/gen_exports.rs",
        "{workspaceRoot}/ports/bindings/**/*",
        "{workspaceRoot}/tools/device/dklog_kinds.py",
        "{workspaceRoot}/tools/device/dkproto.py",
        "{workspaceRoot}/packages/dkneeds/src/gen_limits.rs",
        "{workspaceRoot}/packages/dkupload/src/gen_proto.rs",
        "{workspaceRoot}/packages/dk-session/src/gen_proto.ts"
      ]
    }
  }
}
