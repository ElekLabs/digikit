{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "sdk/glyphs",
  "implicitDependencies": ["@digi/dkglyph"],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/packages/dkglyph/src/**/*", "{workspaceRoot}/packages/dkglyph/cli/**/*"],
      "outputs": [],
      "options": {
        "command": "node packages/dkglyph/cli/glyphs.mjs check sdk/glyphs/digikit",
        "cwd": "."
      }
    }
  }
}
